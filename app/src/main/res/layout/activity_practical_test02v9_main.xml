<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".PracticalTest02v9MainActivity">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Server Configuration"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/server_port_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Server Port"
            android:text="5000"
            android:inputType="number" />

        <Button
            android:id="@+id/connect_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start Server" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#CCCCCC"
            android:layout_marginVertical="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Client Request"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/word_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Anagram Word (e.g. program)"
            android:text="program"/>

        <EditText
            android:id="@+id/min_len_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Min Letters (e.g. 4)"
            android:text="4"
            android:inputType="number"/>

        <Button
            android:id="@+id/get_anagrams_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Get Anagrams" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Result:"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/result_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="5"
            android:gravity="top|start"
            android:background="#EEEEEE"
            android:padding="8dp"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</ScrollView>